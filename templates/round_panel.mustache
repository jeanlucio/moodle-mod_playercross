{{!
    @template mod_playercross/round_panel

    Active-round panel: the theme concept's own word (shown openly, as a caption —
    never tiled), its clue as the mystery-phrase tiles below, and term progress,
    followed by either the term/final-guess forms (mod_playercross/round_play) or the
    post-round result (mod_playercross/round_result), depending on whether the round
    has finished.

    The mystery-phrase tiles and its submit button are replaced by a plain
    checkmark-and-word line — the same resolved-answer style round_play.mustache
    already uses for a solved term — as soon as themesolved is true. That happens
    either once the round is finished, or earlier, the moment a direct guess through
    this same form is confirmed correct (finalguesscorrect), even with terms still
    pending: the phrase is already fully spelled out letter-by-letter in the tiles at
    that point anyway, so leaving the tile grid and a still-live submit button on
    screen for a form that has nothing left to resolve would be misleading. The
    checkmark itself only appears when finalguesscorrect is genuinely true — a round
    lost via forfeit/timeout/termsexhausted still sets themesolved (so the tiles still
    collapse to text), but shows the phrase without a checkmark, since the player never
    actually solved it.

    Example context (json):
    {
        "themeconceptlabel": "Concept",
        "themeconcept": "Administração",
        "themetiles": [
            {
                "tiles": [
                    {"letter": "Á", "revealed": true, "slotnum": "", "arialabel": "Á, revealed"},
                    {"letter": "", "revealed": false, "slotnum": "4", "arialabel": "Hidden letter, slot 4"}
                ]
            },
            {
                "tiles": [
                    {"letter": "D", "revealed": true, "slotnum": "", "arialabel": "D, revealed"},
                    {"letter": "E", "revealed": true, "slotnum": "", "arialabel": "E, revealed"}
                ]
            }
        ],
        "themesolved": false,
        "finalguesscorrect": false,
        "themedisplayword": "",
        "themelabel": "Mystery phrase",
        "showglobalhint": true,
        "globalhintlabel": "Hint",
        "showhintsremaining": true,
        "hintsremainingvalue": "3",
        "hintsremaininglabel": "Hints left: 3",
        "hudhintcost": true,
        "hudhintcostlabel": "You have 3× Gold Key. Costs 1×.",
        "canaffordhint": true,
        "termsprogresslabel": "0 of 5 terms resolved",
        "terms": [
            {
                "termid": 12,
                "phrase": "A place to keep notes and school exercises",
                "resolved": false,
                "exhausted": false,
                "attemptsused": 0,
                "revealword": "",
                "tiles": [
                    {"letter": "", "revealed": false, "slotnum": "3", "arialabel": "Hidden letter, slot 3"}
                ],
                "canguess": true
            }
        ],
        "guesslabel": "Your answer",
        "submittermguess": "Submit",
        "canfinalguess": true,
        "submitfinalguess": "Guess the mystery phrase",
        "showfinalguessattemptsremaining": true,
        "finalguessattemptsremainingvalue": "3",
        "finalguessattemptsremaininglabel": "Attempts left: 3",
        "finalguessexhausted": false,
        "finalguessexhaustedlabel": "",
        "keyboardlabel": "Virtual keyboard",
        "keyboardbackspacelabel": "Delete last letter",
        "showcedilla": false,
        "revealedlettersjson": "[\"A\",\"C\"]",
        "roundfinished": false,
        "feedbackmessage": "",
        "revealthemeword": "",
        "revealthemewordlabel": "The mystery phrase was:",
        "scoreachieved": "",
        "scoreachievedlabel": "Score achieved:",
        "cooldowntext": "",
        "cooldowncountdownlabel": "Next round in",
        "cooldownactive": false,
        "newroundlabel": "Start a new round",
        "showgradesofar": false,
        "gradesofarmessage": "",
        "roundsplayedlabel": "",
        "huditemrewardedlabel": ""
    }
}}
<div id="playercross-round-panel">
    <div class="mod-playercross-concept text-center">
        <div class="mod-playercross-concept-eyebrow">{{themeconceptlabel}}</div>
        <div class="mod-playercross-concept-word">{{themeconcept}}</div>
    </div>
    <form id="playercross-final-guess-form" class="mod-playercross-theme-form mod-playercross-guess-form mb-2">
        <p class="fw-bold d-block text-center mb-1">{{themelabel}}</p>
        {{^themesolved}}
            <div class="mod-playercross-theme" {{#canfinalguess}}role="group" aria-label="{{themelabel}}"{{/canfinalguess}}>
                {{#themetiles}}
                    <div class="mod-playercross-word-group">
                        {{#tiles}}
                            <div class="mod-playercross-tile-wrap small">
                                {{#revealed}}
                                    <span class="mod-playercross-tile is-revealed"
                                          aria-label="{{arialabel}}">{{letter}}</span>
                                {{/revealed}}
                                {{^revealed}}
                                    <input type="text"
                                           class="mod-playercross-tile mod-playercross-tile-input"
                                           inputmode="none"
                                           autocomplete="off"
                                           maxlength="1"
                                           aria-label="{{arialabel}}"
                                           required>
                                {{/revealed}}
                                <span class="mod-playercross-tile-num">{{slotnum}}</span>
                            </div>
                        {{/tiles}}
                    </div>
                {{/themetiles}}
            </div>
            {{#canfinalguess}}
                <button type="submit" class="pc-row-submit">{{submitfinalguess}}</button>
                {{#showfinalguessattemptsremaining}}
                    <span class="mod-playercross-attempts-count"
                          aria-label="{{finalguessattemptsremaininglabel}}">×{{finalguessattemptsremainingvalue}}</span>
                {{/showfinalguessattemptsremaining}}
            {{/canfinalguess}}
        {{/themesolved}}
        {{#themesolved}}
            <p class="text-center mb-0">
                {{! Reuses .mod-playercross-term-answer for the mystery-phrase's own resolved-answer line. }}
                <span class="mod-playercross-term-answer">{{#finalguesscorrect}}&#10003; {{/finalguesscorrect}}{{themedisplayword}}</span>
            </p>
            {{#finalguessexhausted}}
                <p class="text-muted small text-center mb-0">{{finalguessexhaustedlabel}}</p>
            {{/finalguessexhausted}}
        {{/themesolved}}
    </form>

    {{#showglobalhint}}
        <div class="text-center mb-2">
            <button type="button"
                    id="playercross-global-hint-button"
                    class="mod-playercross-hint-btn"
                    {{#showhintsremaining}}
                        aria-label="{{globalhintlabel}} — {{hintsremaininglabel}}"
                    {{/showhintsremaining}}
                    {{#hudhintcost}}
                        title="{{hudhintcostlabel}}"
                        data-hud-confirm-title="{{globalhintlabel}}"
                        data-hud-confirm-body="{{hudhintcostlabel}}"
                        {{^canaffordhint}}data-hud-confirm-insufficient="1"{{/canaffordhint}}
                    {{/hudhintcost}}>
                <i class="fa fa-lightbulb" aria-hidden="true"></i> {{globalhintlabel}}
                {{#showhintsremaining}}
                    <span class="mod-playercross-hint-count" aria-hidden="true">×{{hintsremainingvalue}}</span>
                {{/showhintsremaining}}
            </button>
        </div>
    {{/showglobalhint}}

    <p class="text-muted small text-center mb-3">{{termsprogresslabel}}</p>

    {{^roundfinished}}
        {{> mod_playercross/round_play}}
    {{/roundfinished}}
    {{#roundfinished}}
        {{> mod_playercross/round_result}}
    {{/roundfinished}}
</div>

{{!
    @template mod_playercross/round_result

    Post-round panel: feedback message, score, a recap of every term's own clue and
    answer word (reusing the 'terms' context round_presenter::
    build_round_panel_context() already builds via build_term_rows() for round_play —
    every term's own revealword is populated once the round is finished, regardless of
    whether the student actually resolved it), cooldown countdown and the new-round
    action. The mystery phrase itself is not repeated here — the theme-form section
    above this panel (round_panel.mustache) already shows it, collapsed to plain text,
    the moment themesolved is true.

    Example context (json):
    {
        "feedbackmessage": "You solved the mystery phrase!",
        "resulttermslabel": "Terms from this round:",
        "terms": [
            {
                "termid": 12,
                "phrase": "A tool used to write",
                "resolved": true,
                "revealword": "CANETA"
            },
            {
                "termid": 13,
                "phrase": "A place to keep notes and school exercises",
                "resolved": false,
                "revealword": "CADERNO"
            }
        ],
        "showscoreachieved": true,
        "scoreachievedlabel": "Score achieved:",
        "scoreachieved": "85.00",
        "cooldowntext": "23h 59m 45s",
        "cooldowncountdownlabel": "Next round in",
        "cooldownactive": false,
        "newroundlabel": "Start a new round",
        "roundsplayedlabel": "Rounds played: 3 / 10.",
        "huditemrewardedlabel": "You received 1× Gold Key!",
        "showranking": true,
        "rankingtitle": "Ranking",
        "rankingemptylabel": "No rounds completed yet.",
        "rankingempty": false,
        "rankingpositionlabel": "Position",
        "rankingplayerlabel": "Player",
        "rankingpointslabel": "Points",
        "rankingrows": [
            {"position": 1, "fullname": "Ana Silva", "totalscore": "300.00", "iscurrentuser": false},
            {"position": 2, "fullname": "You", "totalscore": "200.00", "iscurrentuser": true}
        ],
        "rankinghasoutsider": false,
        "rankingoutsiderrow": {"position": 0, "fullname": "", "totalscore": "", "iscurrentuser": false}
    }
}}
<div id="playercross-round-result" tabindex="-1">
    {{#feedbackmessage}}
        <p class="mod-playercross-feedback fw-bold mt-3 text-center">{{feedbackmessage}}</p>
    {{/feedbackmessage}}
    {{#showscoreachieved}}
        <div class="mod-playercross-reveal alert alert-secondary mt-3 text-center">
            <p class="mb-0">{{scoreachievedlabel}} {{scoreachieved}}</p>
        </div>
    {{/showscoreachieved}}
    <p class="fw-bold text-center mt-3 mb-2">{{resulttermslabel}}</p>
    <ul class="mod-playercross-terms list-unstyled">
        {{#terms}}
            <li class="mod-playercross-term{{#resolved}} is-resolved{{/resolved}}">
                <p class="mod-playercross-term-phrase">{{phrase}}</p>
                <span class="mod-playercross-term-answer">{{#resolved}}&#10003; {{/resolved}}{{revealword}}</span>
            </li>
        {{/terms}}
    </ul>
    {{#huditemrewardedlabel}}
        <p class="mt-2 text-center">{{huditemrewardedlabel}}</p>
    {{/huditemrewardedlabel}}
    {{#roundsplayedlabel}}
        <p class="small mt-1 text-center">{{roundsplayedlabel}}</p>
    {{/roundsplayedlabel}}
    {{#cooldowntext}}
        <p class="mt-2 text-center">
            {{cooldowncountdownlabel}}
            <strong>
                <span id="playercross-cooldown-countdown">{{cooldowntext}}</span>
            </strong>
        </p>
    {{/cooldowntext}}
    {{#showranking}}
        <div class="mod-playercross-ranking-inline mt-3">
            <h6 class="mb-2">{{rankingtitle}}</h6>
            {{#rankingempty}}
                <p class="text-muted small">{{rankingemptylabel}}</p>
            {{/rankingempty}}
            {{^rankingempty}}
                <table class="table table-sm mod-playercross-ranking-table">
                    <thead>
                        <tr>
                            <th scope="col"><i class="fa fa-trophy" role="img" aria-label="{{rankingpositionlabel}}"></i></th>
                            <th scope="col">{{rankingplayerlabel}}</th>
                            <th scope="col" class="text-end">{{rankingpointslabel}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rankingrows}}
                            <tr class="{{#iscurrentuser}}pc-ranking-you{{/iscurrentuser}}">
                                <td>{{position}}</td>
                                <td>{{fullname}}</td>
                                <td class="text-end">{{totalscore}}</td>
                            </tr>
                        {{/rankingrows}}
                        {{#rankinghasoutsider}}
                            <tr>
                                <td colspan="3" class="text-center text-muted pc-ranking-sep">&hellip;</td>
                            </tr>
                            <tr class="pc-ranking-you">
                                <td>{{rankingoutsiderrow.position}}</td>
                                <td>{{rankingoutsiderrow.fullname}}</td>
                                <td class="text-end">{{rankingoutsiderrow.totalscore}}</td>
                            </tr>
                        {{/rankinghasoutsider}}
                    </tbody>
                </table>
            {{/rankingempty}}
        </div>
    {{/showranking}}
    {{^cooldownactive}}
    <div class="text-center">
        <button type="button" id="playercross-new-round-button" class="btn btn-secondary mt-2">{{newroundlabel}}</button>
    </div>
    {{/cooldownactive}}
</div>

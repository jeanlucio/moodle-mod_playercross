{{!
    Rendered outside and above the game card, not inside it: mod-playercross-game is
    width: fit-content, sized to the card's own content (toolbar, puzzle grid). This
    status block is teacher-only meta-information, not part of the game itself, and
    a long inactive-words list has no natural width limit — nesting it inside the
    card would either force the whole card wide or squeeze a long list into the
    card's narrow width. Kept above the card rather than below it for the same
    reason as before: the on-screen keyboard inside #playercross-stage is
    position: fixed to the viewport's bottom edge on mobile, with no reserved space
    of its own for content that comes after it in the document — anything placed
    below the stage risks sitting behind the keyboard, mostly hidden, with only a
    sliver of descenders (e.g. "jogo"'s j/g) peeking out.
}}
{{#showwordsstatus}}
    {{#hasinactivewords}}
        {{> mod_playercross/inactive_words}}
    {{/hasinactivewords}}
    {{^hasinactivewords}}
        <p class="mod-playercross-words-status text-muted small mb-2">{{activewordscountterm}}</p>
        <p class="mod-playercross-words-status text-muted small mb-2">{{activewordscounttheme}}</p>
    {{/hasinactivewords}}
{{/showwordsstatus}}

<div class="mod-playercross-game">
    <div class="pc-header">
        {{> mod_playercross/toolbar}}
        {{#timerenabled}}
            <span id="playercross-timer-wrapper" class="pc-header-timer"
                {{#showlobby}}hidden{{/showlobby}}
                {{#roundfinished}}hidden{{/roundfinished}}>
                <i class="fa fa-clock-o" aria-hidden="true"></i>
                <span id="playercross-timer-countdown" aria-label="{{timerlabel}}">{{timeleft}}</span>
            </span>
        {{/timerenabled}}
    </div>

    {{^hastheme}}
        <div class="alert alert-warning">{{nogamewords}}</div>
    {{/hastheme}}

    {{#hastheme}}
        <div id="playercross-stage">
            {{#showlobby}}
                {{> mod_playercross/lobby}}
            {{/showlobby}}
            {{^showlobby}}
                {{> mod_playercross/round_panel}}
            {{/showlobby}}
        </div>
    {{/hastheme}}

    <div id="playercross-live-region"
         class="visually-hidden"
         aria-live="polite"
         aria-atomic="true"></div>

    <div id="playercross-help-content" hidden>
        {{> mod_playercross/help_body}}
    </div>
</div>

{{!
    @template mod_playercross/attempts_report

    All-students round history report for a PlayerCross activity, shown only to
    whoever can manage the activity (mod/playercross:addinstance). Paginated,
    sortable, filterable by student.

    Example context (json):
    {
        "activityurl": "https://example.com/mod/playercross/view.php?id=1",
        "backlabel": "Back to game",
        "cmid": 1,
        "reporttitle": "Attempt history — All students",
        "emptylabel": "No student has finished a round yet.",
        "finalguessedlabel": "Direct guess",
        "yeslabel": "Yes",
        "nolabel": "No",
        "isempty": false,
        "showranking": true,
        "rankingpointslabel": "Ranking points",
        "filterlabel": "Student",
        "filterbuttonlabel": "Filter",
        "filterurl": "https://example.com/mod/playercross/attemptsreport.php",
        "currentsort": "date",
        "currentdir": "DESC",
        "studentoptions": [
            {"id": 0, "name": "All students", "selected": true},
            {"id": 3, "name": "Ana Silva", "selected": false}
        ],
        "columns": [
            {"key": "student", "label": "Student", "alignend": false, "url": "https://example.com/mod/playercross/attemptsreport.php?sort=student", "active": false, "arrow": ""},
            {"key": "theme", "label": "Mystery phrase", "alignend": false, "url": "https://example.com/mod/playercross/attemptsreport.php?sort=theme", "active": false, "arrow": ""},
            {"key": "terms", "label": "Terms", "alignend": true, "url": "https://example.com/mod/playercross/attemptsreport.php?sort=terms", "active": false, "arrow": ""},
            {"key": "attempts", "label": "Attempts", "alignend": true, "url": "https://example.com/mod/playercross/attemptsreport.php?sort=attempts", "active": false, "arrow": ""},
            {"key": "time", "label": "Time", "alignend": true, "url": "https://example.com/mod/playercross/attemptsreport.php?sort=time", "active": false, "arrow": ""},
            {"key": "score", "label": "Score", "alignend": true, "url": "https://example.com/mod/playercross/attemptsreport.php?sort=score", "active": false, "arrow": ""},
            {"key": "date", "label": "Date", "alignend": false, "url": "https://example.com/mod/playercross/attemptsreport.php?sort=date", "active": true, "arrow": " ▼"}
        ],
        "rows": [
            {
                "student": "Ana Silva",
                "themeword": "Escola",
                "termsresolved": 3,
                "termstotal": 3,
                "finalguessed": false,
                "attemptsused": 5,
                "timeused": "1:24",
                "won": true,
                "score": "85.00",
                "rankingpoints": "85.00",
                "datecreated": "14 July 2026, 9:00 AM"
            }
        ],
        "pagingbar": "",
        "candelete": true,
        "sesskey": "abc123",
        "selectalllabel": "Select all",
        "bulkdeletebutton": "Delete selected",
        "bulkdeletetitle": "Delete attempts",
        "bulkdeleteconfirm": "Are you sure you want to delete the selected attempts? This action cannot be undone.",
        "deleteattemptlabel": "Delete attempt",
        "deleteattemptconfirm": "Are you sure you want to delete this attempt? This action cannot be undone.",
        "showhudwarning": true,
        "hudwarningtext": "PlayerHUD items granted for winning are not removed when an attempt is deleted."
    }
}}
<div class="mod-playercross-attemptsreport-page">
    <p>
        <a href="{{activityurl}}" class="btn btn-secondary btn-sm">{{backlabel}}</a>
    </p>
    <h2>{{reporttitle}}</h2>

    {{#showhudwarning}}
        <p class="small">{{hudwarningtext}}</p>
    {{/showhudwarning}}

    <form method="get" action="{{filterurl}}" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="sort" value="{{currentsort}}">
        <input type="hidden" name="dir" value="{{currentdir}}">
        <div class="col-auto">
            <label for="playercross-filter-student" class="form-label">{{filterlabel}}</label>
            <select name="studentid" id="playercross-filter-student" class="form-select">
                {{#studentoptions}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/studentoptions}}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary">{{filterbuttonlabel}}</button>
        </div>
    </form>

    {{#isempty}}
        <p class="text-muted">{{emptylabel}}</p>
    {{/isempty}}
    {{^isempty}}
        <form id="playercross-attempts-form" method="post" action="attemptsreport.php">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="sort" value="{{currentsort}}">
            <input type="hidden" name="dir" value="{{currentdir}}">
            <input type="hidden" name="studentid" value="{{filteruserid}}">
            <input type="hidden" name="page" value="{{currentpage}}">
            <input type="hidden" id="playercross-bulk-action" name="bulkaction" value="">

            {{#candelete}}
                <div class="mb-2">
                    <button type="button"
                            id="playercross-attempts-bulk-delete-btn"
                            class="btn btn-outline-danger btn-sm"
                            data-labelbase="{{bulkdeletebutton}}"
                            data-title="{{bulkdeletetitle}}"
                            data-confirm="{{bulkdeleteconfirm}}"
                            disabled>
                        {{bulkdeletebutton}}
                    </button>
                </div>
            {{/candelete}}

            <div class="table-responsive">
                <table class="table table-sm mod-playercross-myattempts-table">
                    <thead>
                        <tr>
                            {{#candelete}}
                                <th scope="col">
                                    <input type="checkbox"
                                           id="playercross-attempts-select-all"
                                           class="form-check-input"
                                           aria-label="{{selectalllabel}}">
                                </th>
                            {{/candelete}}
                            {{#columns}}
                                <th scope="col" {{#alignend}}class="text-end"{{/alignend}}>
                                    <a href="{{url}}">{{label}}{{arrow}}</a>
                                </th>
                            {{/columns}}
                            {{#candelete}}
                                <th scope="col"></th>
                            {{/candelete}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                {{#candelete}}
                                    <td>
                                        <input type="checkbox"
                                               name="attemptid[]"
                                               value="{{id}}"
                                               class="form-check-input playercross-attempts-bulk-check"
                                               aria-label="{{deleteattemptlabel}} — {{student}}">
                                    </td>
                                {{/candelete}}
                                <td>{{student}}</td>
                                <td>{{themeword}}</td>
                                <td class="text-end">{{termsresolved}}/{{termstotal}}</td>
                                <td class="text-end">{{attemptsused}}</td>
                                <td class="text-end">{{timeused}}</td>
                                <td class="text-end">{{score}}</td>
                                {{#showranking}}
                                    <td class="text-end">{{rankingpoints}}</td>
                                {{/showranking}}
                                <td>{{datecreated}}</td>
                                {{#candelete}}
                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm playercross-attempts-single-delete-btn"
                                                data-attemptid="{{id}}"
                                                data-title="{{deleteattemptlabel}}"
                                                data-confirm="{{deleteattemptconfirm}}"
                                                aria-label="{{deleteattemptlabel}} — {{student}}">
                                            {{deleteattemptlabel}}
                                        </button>
                                    </td>
                                {{/candelete}}
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        </form>
        {{{pagingbar}}}
    {{/isempty}}
</div>

{{!
    @template mod_playercross/help_body

    How-to-play help content for a PlayerCross activity, shown inside a modal
    opened from the in-game toolbar (see amd/src/game.js).

    termlosstext and finalguesslosstext each embed a real
    .mod-playercross-attempts-count pill (styled in styles.css) reading "×N"
    directly in their own sentence — view_page_service::build_help_context()
    builds that pill with html_writer::tag() and injects it through each
    lang string's own {$a} placeholder, so the CSS class name never lives in
    a translatable string and every language keeps full control over where
    the pill sits in its own sentence. Trusted and static (never user
    input), so rendered with triple-mustache below. Not aria-hidden: the
    "×N" pill is the sentence's own content here, not a decorative echo of
    text already read aloud elsewhere.

    Example context (json):
    {
        "introtext": "Solve terms about course concepts. Each correct answer reveals that term's own letters in every other pending term and the mystery phrase that share the same letter.",
        "legendrevealedlabel": "Revealed: this letter is known.",
        "legendhiddenlabel": "Hidden: this letter is not known yet.",
        "termstext": "Each term is a separate word about a course concept; guess it in the box next to it — each letter you type moves you to the next box automatically.",
        "submittext": "As soon as you finish typing a word, a button appears right next to it to check that word — you do not need to fill in every term first.",
        "showhint": true,
        "hinttext": "A hint button reveals one letter at a time, anywhere in the round — that letter shows up in every pending term and the mystery phrase that share it.",
        "finalguesstext": "You can guess the mystery phrase directly at any time, even with terms still pending.",
        "showfinalguessbonus": true,
        "finalguessbonustext": "Guessing the mystery phrase correctly before resolving any term guarantees a 10% grade bonus.",
        "showrankingbonus": true,
        "rankingbonustext": "Guessing the mystery phrase correctly before resolving any term also guarantees a 10% ranking bonus, whenever ranking is enabled.",
        "winconditiontext": "To win a round, you must resolve every term and correctly guess the mystery phrase — in either order.",
        "showtermloss": true,
        "termlosstext": "Each term has a limited number of attempts, shown as <span class=\"mod-playercross-attempts-count\">×N</span> next to it. If one runs out, winning becomes impossible and the round ends immediately as a loss.",
        "showfinalguessloss": true,
        "finalguesslosstext": "The mystery phrase also has a limited number of attempts, shown as <span class=\"mod-playercross-attempts-count\">×N</span> next to it. If they run out, the round ends immediately as a loss, no matter how the round can be won.",
        "showtimer": true,
        "timertext": "This activity has a 2-minute time limit per round.",
        "showhud": true,
        "hudtext": "This activity may require PlayerHUD items to start a round or reveal a hint, and can reward you with an item for winning a round.",
        "showgrading": true,
        "gradingtext": "Grading method: Highest grade.",
        "showscoringformula": true,
        "scoringformulatext": "Grading uses linear scoring: you get full credit with no wrong guesses, and credit decreases with every wrong guess across every term and the mystery phrase.",
        "reviewhint": "You can review these instructions anytime by clicking the help icon at the top of the game."
    }
}}
<div class="mod-playercross-help-body">
    <p>{{introtext}}</p>
    <ul class="mod-playercross-help-legend">
        <li><span class="pc-legend-swatch is-revealed" aria-hidden="true">A</span> {{legendrevealedlabel}}</li>
        <li><span class="pc-legend-swatch is-hidden" aria-hidden="true">A</span> {{legendhiddenlabel}}</li>
    </ul>
    <p>{{termstext}}</p>
    <p>{{submittext}}</p>
    {{#showhint}}
        <p>{{hinttext}}</p>
    {{/showhint}}
    <p>{{finalguesstext}}</p>
    {{#showfinalguessbonus}}
        <p>{{finalguessbonustext}}</p>
    {{/showfinalguessbonus}}
    {{#showrankingbonus}}
        <p>{{rankingbonustext}}</p>
    {{/showrankingbonus}}
    <p>{{winconditiontext}}</p>
    {{#showtermloss}}
        <p>{{{termlosstext}}}</p>
    {{/showtermloss}}
    {{#showfinalguessloss}}
        <p>{{{finalguesslosstext}}}</p>
    {{/showfinalguessloss}}
    {{#showtimer}}
        <p>{{timertext}}</p>
    {{/showtimer}}
    {{#showhud}}
        <p>{{hudtext}}</p>
    {{/showhud}}
    {{#showgrading}}
        <p>{{gradingtext}}</p>
    {{/showgrading}}
    {{#showscoringformula}}
        <p>{{scoringformulatext}}</p>
    {{/showscoringformula}}
    <p>{{reviewhint}}</p>
</div>

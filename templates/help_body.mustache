{{!
    @template mod_playercross/help_body

    How-to-play help content for a PlayerCross activity, shown inside a modal
    opened from the in-game toolbar (see amd/src/game.js).

    The termloss/finalguessloss paragraphs each end with a static example of the
    real attempts-remaining pill (.mod-playercross-attempts-count, styled in
    styles.css) shown during play — a fixed illustrative number, not real round
    data, so it is aria-hidden; the paragraph text right before it already
    explains what the count means for anyone using a screen reader.

    Example context (json):
    {
        "introtext": "Solve terms about course concepts. Each correct answer reveals letters the term shares with the mystery phrase, in every pending term and in the mystery phrase itself.",
        "legendrevealedlabel": "Revealed: this letter is known.",
        "legendhiddenlabel": "Hidden: this letter is not known yet.",
        "termstext": "Each term is a separate word about a course concept; guess it in the box next to it — each letter you type moves you to the next box automatically.",
        "submittext": "As soon as you finish typing a word, a button appears right next to it to check that word — you do not need to fill in every term first.",
        "hinttext": "A hint may be available for each term, depending on how the teacher configured the activity.",
        "finalguesstext": "You can guess the mystery phrase directly at any time, even with terms still pending — the earlier you guess correctly, the bigger the bonus.",
        "winconditiontext": "To win a round, you must resolve every term and correctly guess the mystery phrase — in either order.",
        "showtermloss": true,
        "termlosstext": "Each term has a limited number of attempts. If one runs out, winning becomes impossible and the round ends immediately as a loss.",
        "showfinalguessloss": true,
        "finalguesslosstext": "The mystery phrase also has a limited number of attempts. If they run out, the round ends immediately as a loss, no matter how the round can be won.",
        "timertext": "Some activities have a time limit per round.",
        "showhud": true,
        "hudtext": "This activity may require PlayerHUD items to start a round or reveal a hint, and can reward you with an item for winning a round.",
        "showgrading": true,
        "gradingtext": "Grading method: Highest grade.",
        "showscoringformula": true,
        "scoringformulatext": "Grading uses linear scoring: you get full credit with no wrong guesses, and credit decreases with every wrong guess across every term and the mystery phrase.",
        "reviewhint": "You can review these instructions anytime by clicking the help icon at the top of the game."
    }
}}
<div class="mod-playercross-help-body">
    <p>{{introtext}}</p>
    <ul class="mod-playercross-help-legend">
        <li><span class="pc-legend-swatch is-revealed" aria-hidden="true">A</span> {{legendrevealedlabel}}</li>
        <li><span class="pc-legend-swatch is-hidden" aria-hidden="true">A</span> {{legendhiddenlabel}}</li>
    </ul>
    <p>{{termstext}}</p>
    <p>{{submittext}}</p>
    <p>{{hinttext}}</p>
    <p>{{finalguesstext}}</p>
    <p>{{winconditiontext}}</p>
    {{#showtermloss}}
        <p>{{termlosstext}} <span class="mod-playercross-attempts-count" aria-hidden="true">×3</span></p>
    {{/showtermloss}}
    {{#showfinalguessloss}}
        <p>{{finalguesslosstext}} <span class="mod-playercross-attempts-count" aria-hidden="true">×1</span></p>
    {{/showfinalguessloss}}
    <p>{{timertext}}</p>
    {{#showhud}}
        <p>{{hudtext}}</p>
    {{/showhud}}
    {{#showgrading}}
        <p>{{gradingtext}}</p>
    {{/showgrading}}
    {{#showscoringformula}}
        <p>{{scoringformulatext}}</p>
    {{/showscoringformula}}
    <p>{{reviewhint}}</p>
</div>
